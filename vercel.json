{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npx next build",
      "outputDirectory": "out"
    },
    "python-api": {
      "root": "python-api",
      "framework": "fastapi",
      "entrypoint": "api:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "python-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
