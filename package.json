    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
